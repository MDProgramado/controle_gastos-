# BFF (server-side): URL da API Spring Boot
API_URL=http://localhost:8080

# Google OAuth/OIDC — apenas nomes de variáveis; preencher no Vercel/Render/.env.local
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Habilita o botão "Entrar com Google" apenas quando configurado
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=1
