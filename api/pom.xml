<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.controlefinanceiro</groupId>
  <artifactId>controle-financeiro-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>controle-financeiro-api</name>
  <description>API do Controle Financeiro — Spring Boot 3 / Java 21</description>

  <properties>
    <!-- Pitfall 11: alvo fixo em Java 21 (runtime da Render), mesmo com JDK local mais novo -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spotless.version>2.46.1</spotless.version>
    <!-- Explicito (o parent ja define): fontes sempre UTF-8, nunca o cp1252 do Windows -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Observabilidade: health/info/prometheus (exposição restrita em application.yml e SecurityConfig) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Fase 4 (D-01): validação oficial do ID token Google (iss/aud/exp/assinatura) -->
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Flyway: desde Flyway 10 o suporte PostgreSQL é módulo separado (Pitfall 3) -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Apache PDFBox: extração de texto de PDF no backend, sem OCR (custo zero, fase 5) -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.5</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Formatação Google Java Style (PLAN §4.3) — check roda no build -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IntegrationTest.java</exclude>
            <exclude>**/*MigrationTest.java</exclude>
          </excludes>
          <environmentVariables>
            <SEED_ADMIN_PASSWORD>fixture-somente-testes-it</SEED_ADMIN_PASSWORD>
            <!-- Segredo JWT de teste (>= 32 bytes, Pitfall 6) — fixture óbvio, não valor real -->
            <JWT_SECRET>fixture-jwt-somente-testes-it-0123456789abcdef</JWT_SECRET>
            <!-- Client ID público de fixture — nunca segredo (o secret fica só no BFF) -->
            <GOOGLE_CLIENT_ID>fixture-google-client-id-somente-testes.apps.googleusercontent.com</GOOGLE_CLIENT_ID>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*IntegrationTest.java</include>
            <include>**/*MigrationTest.java</include>
          </includes>
          <environmentVariables>
            <SEED_ADMIN_PASSWORD>fixture-somente-testes-it</SEED_ADMIN_PASSWORD>
            <JWT_SECRET>fixture-jwt-somente-testes-it-0123456789abcdef</JWT_SECRET>
            <GOOGLE_CLIENT_ID>fixture-google-client-id-somente-testes.apps.googleusercontent.com</GOOGLE_CLIENT_ID>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <lineEndings>UNIX</lineEndings>
            <googleJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
