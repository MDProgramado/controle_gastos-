# Configuração opcional do assistente financeiro (valores padrão já funcionam).
# No Docker/Render o corpus é copiado para /app/rag e AI_RAG_CORPUS_PATH é definido no Dockerfile.
# Local: use ../rag/... se você inicia a API dentro de api/; use rag/... se inicia na raiz.
AI_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_RAG_CORPUS_PATH=../rag/corpus_financeiro_RAG_chunks.jsonl
AI_RAG_EMBEDDING_BATCH_SIZE=64
